PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

CLIENT_URL=http://localhost:5174

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auth / JWT ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ── Forgot Password / OTP ──────────────────────────────────
OTP_EXPIRE_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
RESET_TOKEN_EXPIRE_MIN=15

# ── Email: choose "gmail" or "smtp" ────────────────────────
EMAIL_PROVIDER=gmail

# Gmail App Password (used when EMAIL_PROVIDER=gmail)
# Generate at https://myaccount.google.com/apppasswords (2FA must be enabled first)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Custom company SMTP (used when EMAIL_PROVIDER=smtp) — Hostinger/Zoho/Outlook/GoDaddy/cPanel etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender identity shown in outgoing emails
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=

# Branding used inside email templates
COMPANY_NAME=
COMPANY_LOGO_URL=

# ── Admin seed script (npm run seed:admin) ─────────────────
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
